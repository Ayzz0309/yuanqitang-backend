rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 員工帳號只能由 Render 後端的 Firebase Admin 建立。
    // 既有前端仍會讀取及更新員工案件資料，因此暫時保留 read/update。
    match /employees/{employeeId} {
      allow read: if true;
      // 過渡期仍允許既有前端寫入打卡關聯資料，但禁止自行改成老闆或換帳號 ID。
      allow update: if request.resource.data.role == resource.data.role
                    && request.resource.data.id == resource.data.id;
      allow create, delete: if false;
    }

    // v2.1.6 過渡規則：既有前端仍直接存取下列集合。
    // 完成 Firebase Authentication 帳號遷移後，應改為依角色限制讀寫。
    match /bookings/{id} {
      allow read, write: if true;
    }
    match /customers/{id} {
      // 客人帳號刪除只能由 Render 後端執行，避免前端誤刪。
      // 預約與優惠券鎖定目前仍由既有前端交易更新。
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /couponCampaigns/{code} {
      // 活動內容可公開讀取；建立、修改與停用只走 Render Admin API。
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /couponClaims/{claimId} {
      // 防止刪除帳號後用同一手機重複領取；只允許 Render Admin API 存取。
      allow read, write: if false;
    }
    match /clocks/{id} {
      allow read, write: if true;
    }
    match /settings/{id} {
      allow read, write: if true;
    }
    match /schedules/{id} {
      allow read, write: if true;
    }
    match /bedLocks/{id} {
      allow read, write: if true;
    }
  }
}

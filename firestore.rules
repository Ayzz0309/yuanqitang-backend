rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 員工帳號只能由 Render 後端的 Firebase Admin 建立。
    // 既有前端仍會讀取及更新員工案件資料，因此暫時保留 read/update。
    match /employees/{employeeId} {
      allow read, update: if true;
      allow create, delete: if false;
    }

    // v2.1.3 過渡規則：既有前端仍直接存取下列集合。
    // 完成 Firebase Authentication 帳號遷移後，應改為依角色限制讀寫。
    match /bookings/{id} {
      allow read, write: if true;
    }
    match /customers/{id} {
      allow read, write: if true;
    }
    match /clocks/{id} {
      allow read, write: if true;
    }
    match /settings/{id} {
      allow read, write: if true;
    }
    match /schedules/{id} {
      allow read, write: if true;
    }
    match /bedLocks/{id} {
      allow read, write: if true;
    }
  }
}
